# Public (non-secret) build settings. Copied into the JavaScript bundle, so never put secrets here.
# Override per environment in .env.production.local or in your host's build settings.

# Where the backend API lives.
REACT_APP_API_URL=http://localhost:8080/api

# The site's public address, used for canonical URLs, social previews and the sitemap.
# Set this to the real domain (no trailing slash) when building for production.
REACT_APP_SITE_URL=http://localhost:3000
